# Local development only. Copy to .env; never commit credentials.
# Generate a separate openssl rand -hex 24 value for each field below.
POSTGRES_PASSWORD=
APP_PASSWORD=
SESSION_SECRET=
APP_API_KEY=

# Works immediately without any provider account.
MODEL_MODE=mock
# To make real calls, use MODEL_MODE=openai-compatible and supply:
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
